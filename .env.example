# Server Port
PORT=3001

# --- 前端构建配置 ---
# 本地开发使用 /api 代理
VITE_API_BASE_URL=/api
ADMIN_TOKEN=password

# 实际部署后使用以下代理
# VITE_ADMIN_API_BASE_URL=https://实际域名/api
# VITE_API_BASE_URL=https://实际域名/api

# --- 腾讯云 COS 配置 ---
# 请填入与 GitHub Secrets 相同的值
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# --- 前端图片 CDN 域名 ---
# 生产环境：CDN 加速域名，如 https://ovodm.top
# 本地开发：也可配置为 CDN 域名直接从 COS 加载图片
VITE_COS_BASE_URL=https://ovodm.top

# --- 数据库配置 ---
# 主库类型：postgres（生产推荐）或 sqlite（本地开发）
DB_PROVIDER=sqlite

# PostgreSQL（DB_PROVIDER=postgres 时必填）
# Docker Compose 环境下 host 为服务名 postgres
PG_CONNECTION=Host=postgres;Port=5432;Database=danmu;Username=danmu;Password=change-me
# docker-compose 中 postgres 容器的初始化参数
PG_DATABASE=danmu
PG_USER=danmu
PG_PASSWORD=change-me

# SQLite 数据库文件路径（DB_PROVIDER=sqlite 时使用；PG 模式下作为历史数据回退）
# Docker 容器内使用 /app/server/data/danmaku.db
# 本地调试使用 server/data/danmaku.db
SQLITE_DB_PATH=server/data/danmaku.db